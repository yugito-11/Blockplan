<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Blockplan.Views"
        xmlns:local="using:Blockplan"
        x:Class="Blockplan.MainWindow"
        Title="Blockplan" Width="1440" Height="900" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" Icon="/Assets/blockplan.ico">
  <Window.Styles>
    <Style Selector="TextBlock.h">
      <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="LetterSpacing" Value="1"/>
    </Style>
    <Style Selector="TextBlock.note">
      <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="ToggleButton.nav">
      <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Height" Value="40"/><Setter Property="Padding" Value="12,0"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,0,3"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="14"/>
    </Style>
    <Style Selector="Border.glass">
      <Setter Property="Background" Value="#D80D120F"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="10,5"/>
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="236,*,300">
    <!-- Navigation links -->
    <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="14,18,14,16" LastChildFill="False">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="11" Margin="6,0,0,18">
          <Image Source="/Assets/blockplan.png" Width="32" Height="32" RenderOptions.BitmapInterpolationMode="None"/>
          <StackPanel>
            <TextBlock Text="Blockplan" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Bauplaner für Minecraft" Classes="note" FontSize="11"/>
          </StackPanel>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="ANSICHTEN" Classes="h" Margin="10,0,0,6"/>
        <ToggleButton DockPanel.Dock="Top" x:Name="Nav2D" Classes="nav" Content="▦  2D-Plan" IsChecked="True"/>
        <ToggleButton DockPanel.Dock="Top" x:Name="Nav3D" Classes="nav" Content="⬢  3D-Ansicht"/>
        <ToggleButton DockPanel.Dock="Top" x:Name="NavMat" Classes="nav" Content="☰  Materialliste"/>
        <ToggleButton DockPanel.Dock="Top" x:Name="NavParts" Classes="nav" Content="◫  Baupläne"/>
        <ToggleButton DockPanel.Dock="Top" x:Name="NavStages" Classes="nav" Content="⟋  Etappen"/>
        <ToggleButton DockPanel.Dock="Top" x:Name="NavTodos" Classes="nav" Content="✓  Team-To-dos"/>
        <Border DockPanel.Dock="Top" Margin="0,14,0,0" Background="{DynamicResource SunkBrush}" CornerRadius="10" Padding="12,10">
          <TextBlock x:Name="ViewHint" Classes="note" Text="Ziehen = verschieben · Mausrad = zoomen"/>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Spacing="8">
          <Border x:Name="InstallBox" IsVisible="False" Background="{DynamicResource SunkBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,6">
            <StackPanel Spacing="6">
              <TextBlock Text="Blockplan installieren" FontWeight="SemiBold"/>
              <TextBlock x:Name="InstallText" Classes="note" TextWrapping="Wrap" Text="Mit Eintrag im Startmenü, Symbol auf dem Desktop und unter Windows „Apps“. Deine Projekte bleiben erhalten."/>
              <CheckBox x:Name="InstallDesktop" Content="Symbol auf dem Desktop" IsChecked="True"/>
              <Button x:Name="BtnInstall" Content="Jetzt installieren" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
            </StackPanel>
          </Border>
          <Border x:Name="UpdateBox" IsVisible="False" Background="{DynamicResource AccentBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,6">
            <StackPanel Spacing="6">
              <TextBlock x:Name="UpdateText" Foreground="White" TextWrapping="Wrap" FontSize="12.5"/>
              <Button x:Name="BtnUpdate" Content="Jetzt neu starten" IsVisible="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="White" Foreground="Black"/>
            </StackPanel>
          </Border>
          <TextBlock Text="PROJEKT" Classes="h" Margin="4,0,0,0"/>
          <ComboBox x:Name="ProjSel" HorizontalAlignment="Stretch" Height="38" FontWeight="SemiBold"/>
          <Button x:Name="BtnOpen" Classes="accent" Content="Schematic öffnen …" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="40"/>
          <Button x:Name="BtnImport" Content="Aus Artefakt importieren …" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="36"/>
          <Border Background="{DynamicResource SunkBrush}" CornerRadius="10" Padding="10,8" Margin="0,4,0,0">
            <StackPanel Spacing="6">
              <TextBlock Text="MINECRAFT-TEXTUREN" Classes="h"/>
              <TextBlock x:Name="TexInfo" Classes="note" Text="Suche Minecraft …"/>
              <Button x:Name="BtnBrowserJar" Content="Im Browser laden" Classes="accent" FontSize="12" Padding="8,3" IsVisible="False"/>
              <Button x:Name="BtnJar" Content="Andere .jar wählen …" FontSize="12" Padding="8,3"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Arbeitsfläche -->
    <Grid Grid.Column="1" x:Name="Stage">
      <v:Plan2D x:Name="Plan"/>
      <v:View3D x:Name="View3" IsVisible="False"/>
      <Border x:Name="Bar3D" Classes="glass" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" IsVisible="False" Padding="6">
        <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <ToggleButton x:Name="FlyBtn" Content="Flugmodus (F)" Foreground="White" Padding="10,4"/>
          <TextBlock Text="Tempo" Foreground="#C8D2CB" VerticalAlignment="Center" FontSize="12"/>
          <Slider x:Name="SpeedSlider" Minimum="1" Maximum="60" Value="8" Width="120" VerticalAlignment="Center"/>
          <TextBlock x:Name="SpeedVal" Foreground="White" VerticalAlignment="Center" FontSize="12" MinWidth="70"/>
          <TextBlock Text="Maus" Foreground="#C8D2CB" VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0"/>
          <Slider x:Name="MouseSlider" Minimum="0.2" Maximum="2" Value="1" Width="110" VerticalAlignment="Center"/>
          <TextBlock x:Name="MouseVal" Foreground="White" VerticalAlignment="Center" FontSize="12" MinWidth="40"/>
          <CheckBox x:Name="Guides3DChk" Content="Hilfslinien" Foreground="White" IsChecked="True" Margin="8,0,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ToggleButton x:Name="StepBtn" Content="▤ Bau-Anleitung" Foreground="White" Padding="10,4" ToolTip.Tip="Ebene für Ebene aufbauen, mit dem Material jeder Ebene"/>
          <ToggleButton x:Name="WalkBtn" Content="🚶 Laufen (G)" Foreground="White" Padding="10,4" ToolTip.Tip="Durch den Bau laufen wie im Spiel: WASD, Leertaste springen, Strg rennen"/>
          <ToggleButton x:Name="NightBtn" Content="☾ Nacht" Foreground="White" Padding="10,4" ToolTip.Tip="Nachts leuchten nur Fackeln, Laternen &amp; Co."/>
          <CheckBox x:Name="SpawnChk" Content="Spawn-Stellen" Foreground="White" IsChecked="True" IsVisible="False" ToolTip.Tip="Rote Kreuze: dort ist es so dunkel, dass Monster erscheinen können"/>
          <ToggleButton x:Name="ShaderBtn" Content="✨ Shader" Foreground="White" Padding="10,4" ToolTip.Tip="Schöne Grafik: Schatten der Sonne, Himmel mit Verlauf, Wasser mit Wellen und Spiegelung, dunklere Innenräume"/>
          <Slider x:Name="SunSlider" Minimum="3" Maximum="177" Value="55" Width="100" VerticalAlignment="Center" IsVisible="False" ToolTip.Tip="Sonnenstand: links Morgen, Mitte Mittag, rechts Abend"/>
          <Button x:Name="PhotoBtn" Content="📷 Foto" Foreground="White" Padding="10,4" ToolTip.Tip="Ein schönes, großes Bild der Ansicht speichern"/>
          <TextBlock x:Name="LightInfo" Foreground="#FFB4B4" VerticalAlignment="Center" FontSize="12"/>
        </StackPanel>
        </StackPanel>
      </Border>
      <Border x:Name="TimeBar" Classes="glass" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12,12,12,48" IsVisible="False" Padding="12,8" Width="640">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Text="ZEITRAFFER" Foreground="#C8D2CB" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock x:Name="TlText" Grid.Column="1" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button x:Name="BtnTlClose" Grid.Column="2" Content="×" Foreground="White" Background="Transparent" Padding="8,0"/>
          </Grid>
          <Slider x:Name="TlSlider" Minimum="0" Maximum="1000"/>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <ToggleButton x:Name="TlPlay" Content="▶ Abspielen" Foreground="White" Padding="10,3"/>
            <ComboBox x:Name="TlDur" SelectedIndex="1" Foreground="White">
              <ComboBoxItem Content="in 10 Sekunden"/>
              <ComboBoxItem Content="in 20 Sekunden"/>
              <ComboBoxItem Content="in 60 Sekunden"/>
            </ComboBox>
            <Button x:Name="BtnTlVideo" Content="🎬 Als Video speichern …" Foreground="White" Padding="10,3"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border x:Name="StepBar" Classes="glass" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12,12,12,48" IsVisible="False" Padding="10,8" MaxWidth="760">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <Button x:Name="StepFirst" Content="⏮" Foreground="White" Padding="8,3" ToolTip.Tip="Erste Ebene"/>
            <Button x:Name="StepPrev" Content="◀" Foreground="White" Padding="10,3" ToolTip.Tip="Ebene zurück (Bild ↓)"/>
            <TextBlock x:Name="StepText" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="240" TextAlignment="Center"/>
            <Button x:Name="StepNext" Content="▶" Foreground="White" Padding="10,3" ToolTip.Tip="Nächste Ebene (Bild ↑)"/>
            <Button x:Name="StepLast" Content="⏭" Foreground="White" Padding="8,3" ToolTip.Tip="Ganzer Bau"/>
            <ToggleButton x:Name="StepPlay" Content="▶ Abspielen" Foreground="White" Padding="10,3" Margin="10,0,0,0"/>
            <Slider x:Name="StepSpeed" Minimum="0.2" Maximum="3" Value="1" Width="90" VerticalAlignment="Center" ToolTip.Tip="Sekunden je Ebene"/>
          </StackPanel>
          <WrapPanel x:Name="StepMat" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
      <Border x:Name="MatPage" IsVisible="False" Background="{DynamicResource BgBrush}" Padding="24">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,14">
            <TextBlock x:Name="MatTitle" Text="Materialliste" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="MatSub" Classes="note"/>
            <WrapPanel Margin="0,8,0,0">
              <ComboBox x:Name="MatScope" MinWidth="240" Margin="0,0,8,6" ToolTip.Tip="Für welchen Teil des Baus?"/>
              <ComboBox x:Name="MatMode" Width="210" Margin="0,0,8,6" SelectedIndex="0">
                <ComboBoxItem Content="Einkaufsliste (Items)"/>
                <ComboBoxItem Content="Blöcke im Plan"/>
              </ComboBox>
              <TextBox x:Name="MatSearch" PlaceholderText="Block suchen …" Width="220" Margin="0,0,8,6"/>
              <Button x:Name="BtnMatCopy" Content="Liste kopieren" Margin="0,0,8,6" ToolTip.Tip="Als Text in die Zwischenablage, z. B. für Discord"/>
              <Button x:Name="BtnExport" Content="Exportieren (.litematic / .schem) …" Margin="0,0,8,6" ToolTip.Tip="Den gewählten Teil (ganzes Projekt, Etappe oder Bauplan) für WorldEdit oder Litematica speichern"/>
              <Button x:Name="BtnUndo" Content="↶ Ersetzen rückgängig" Margin="0,0,8,6" IsVisible="False"/>
            </WrapPanel>
            <Border x:Name="MatSpace" Background="{DynamicResource SunkBrush}" CornerRadius="10" Padding="12,8" HorizontalAlignment="Left">
              <TextBlock x:Name="MatSpaceText" FontWeight="SemiBold"/>
            </Border>
          </StackPanel>
          <Border Classes="card" Padding="0">
            <ListBox x:Name="MatList" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:MatRow">
                  <Grid ColumnDefinitions="28,*,110,220,Auto" Height="30">
                    <Image Grid.Column="0" Source="{Binding Icon}" Width="22" Height="22" RenderOptions.BitmapInterpolationMode="None"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                      <TextBlock Text="{Binding Name}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding CountText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas,monospace"/>
                    <TextBlock Grid.Column="3" Text="{Binding StackText}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                    <Button Grid.Column="4" Content="Ersetzen …" IsVisible="{Binding CanReplace}" Command="{Binding Replace}" Margin="12,0,0,0" Padding="8,2" FontSize="12" VerticalAlignment="Center"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </DockPanel>
      </Border>

      <ContentControl x:Name="PartsHost" IsVisible="False" Background="{DynamicResource BgBrush}"/>
      <ContentControl x:Name="StagesHost" IsVisible="False" Background="{DynamicResource BgBrush}"/>
      <ContentControl x:Name="TodosHost" IsVisible="False" Background="{DynamicResource BgBrush}"/>
      <Border x:Name="MeasureBox" Classes="glass" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12,40,12,0" IsVisible="False" BorderBrush="#FF8FBF" BorderThickness="1">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock x:Name="MeasureText" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
          <Button x:Name="BtnMeasureClear" Content="×" Padding="6,0" Foreground="White" Background="Transparent"/>
        </StackPanel>
      </Border>
      <Border x:Name="HoverBox" Classes="glass" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" IsVisible="False">
        <TextBlock x:Name="HoverText" Foreground="White" FontSize="12"/>
      </Border>
      <Border x:Name="StatusBox" Classes="glass" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" IsVisible="False">
        <TextBlock x:Name="StatusText" Foreground="#C8D2CB" FontSize="11.5"/>
      </Border>
      <Border x:Name="BusyBox" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource CardBrush}"
              BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="22,16" MinWidth="300" BoxShadow="0 18 50 0 #59000000">
        <StackPanel Spacing="8">
          <TextBlock x:Name="BusyText" FontWeight="SemiBold" Text="Lade …"/>
          <ProgressBar IsIndeterminate="True" Height="4"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Menü rechts -->
    <Border Grid.Column="2" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
      <ScrollViewer>
        <StackPanel Margin="14" Spacing="12">
          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Text="ANSICHT" Classes="h"/>
              <StackPanel Orientation="Horizontal" Spacing="6" x:Name="ModeRow">
                <RadioButton x:Name="ModeTop" Content="Draufsicht" IsChecked="True" GroupName="m"/>
                <RadioButton x:Name="ModeLayer" Content="Eine Schicht" GroupName="m"/>
              </StackPanel>
              <StackPanel x:Name="LayerRow" Spacing="4" IsVisible="False">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Schicht" Classes="note" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button x:Name="LayerDown" Content="◀" Padding="8,2"/>
                    <TextBlock x:Name="LayerVal" FontFamily="Consolas,monospace" VerticalAlignment="Center" MinWidth="70" TextAlignment="Center"/>
                    <Button x:Name="LayerUp" Content="▶" Padding="8,2"/>
                  </StackPanel>
                </Grid>
                <Slider x:Name="LayerSlider" Minimum="0" Maximum="1" TickFrequency="1" IsSnapToTickEnabled="True"/>
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Zeigen bis Höhe" Classes="note" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="CutVal" FontFamily="Consolas,monospace"/>
              </Grid>
              <Slider x:Name="CutSlider" Minimum="0" Maximum="1" TickFrequency="1" IsSnapToTickEnabled="True"/>
              <Button x:Name="BtnFit" Content="Ansicht zurücksetzen" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
            </StackPanel>
          </Border>

          <Border Classes="card" x:Name="CutCard" IsVisible="False">
            <StackPanel Spacing="8">
              <TextBlock Text="SCHNITT" Classes="h"/>
              <TextBlock Classes="note" Text="Den Bau aufschneiden und hineinschauen."/>
              <ComboBox x:Name="CutAxis" HorizontalAlignment="Stretch" SelectedIndex="0">
                <ComboBoxItem Content="Kein Schnitt"/>
                <ComboBoxItem Content="Schnitt Nord–Süd (entlang X)"/>
                <ComboBoxItem Content="Schnitt West–Ost (entlang Z)"/>
              </ComboBox>
              <Grid ColumnDefinitions="*,Auto" x:Name="CutPosRow" IsVisible="False">
                <TextBlock Text="Schnitt bei" Classes="note" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="CutPosVal" FontFamily="Consolas,monospace"/>
              </Grid>
              <Slider x:Name="CutPos" Minimum="0" Maximum="1" TickFrequency="1" IsSnapToTickEnabled="True" IsVisible="False"/>
              <CheckBox x:Name="CutOther" Content="Andere Hälfte zeigen" IsVisible="False"/>
            </StackPanel>
          </Border>

          <Border Classes="card" x:Name="LiveCard">
            <StackPanel Spacing="8">
              <TextBlock Text="LIVE-SERVER" Classes="h"/>
              <TextBlock Classes="note" Text="Link aus dem Server-Log (Mod blockplan-live), z. B. http://adresse:8100/?t=…"/>
              <TextBox x:Name="LiveLink" PlaceholderText="http://…:8100/?t=…"/>
              <Grid ColumnDefinitions="*,6,*">
                <Button x:Name="BtnLive" Content="Verbinden" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                <Button x:Name="BtnLiveStop" Grid.Column="2" Content="Trennen" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="False"/>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border x:Name="LiveDot" Width="9" Height="9" CornerRadius="5" Background="Gray" VerticalAlignment="Center"/>
                <TextBlock x:Name="LiveStatus" Classes="note" Text="Nicht verbunden."/>
              </StackPanel>
              <TextBlock x:Name="LiveProgress" Classes="note" FontWeight="SemiBold"/>
              <CheckBox x:Name="LiveProgChk" Content="Baufortschritt zeigen" IsChecked="True"/>
              <CheckBox x:Name="LiveSurrChk" Content="Umgebung aus der Welt zeigen" IsChecked="True"/>
              <Border x:Name="BauBox" Background="{DynamicResource SunkBrush}" CornerRadius="8" Padding="10,8" IsVisible="False">
                <StackPanel Spacing="6">
                  <TextBlock Text="Bauen im Spiel" FontWeight="SemiBold"/>
                  <TextBlock Classes="note" Text="Der Plan erscheint im Spiel als Geisterblöcke an der Startecke. Falsche Blöcke rot, gedrehte orange."/>
                  <ComboBox x:Name="BauScope" HorizontalAlignment="Stretch" ToolTip.Tip="Welcher Teil soll im Spiel erscheinen?"/>
                  <Button x:Name="BtnBauSend" Content="Plan ins Spiel" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <CheckBox x:Name="BauShow" Content="Zeigen" IsChecked="True"/>
                    <CheckBox x:Name="BauLayer" Content="Nur eine Ebene"/>
                  </StackPanel>
                  <TextBlock x:Name="BauText" Classes="note" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <Border x:Name="NavBox" Background="{DynamicResource SunkBrush}" CornerRadius="8" Padding="10,8" IsVisible="False">
                <StackPanel Spacing="6">
                  <TextBlock Text="Was fehlt noch?" FontWeight="SemiBold"/>
                  <Button x:Name="BtnNavFind" Content="Fehlende Stellen suchen" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                  <Grid x:Name="NavRow" ColumnDefinitions="Auto,*,Auto,6,Auto" IsVisible="False">
                    <Button x:Name="BtnNavPrev" Content="◀" Padding="8,2"/>
                    <TextBlock x:Name="NavIdx" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="Consolas,monospace"/>
                    <Button x:Name="BtnNavNext" Grid.Column="2" Content="▶" Padding="8,2"/>
                    <Button x:Name="BtnNavShow" Grid.Column="4" Content="Zeigen" Classes="accent" Padding="10,2"/>
                  </Grid>
                  <TextBlock x:Name="NavText" Classes="note"/>
                </StackPanel>
              </Border>
              <Border x:Name="TlBox" Background="{DynamicResource SunkBrush}" CornerRadius="8" Padding="10,8">
                <StackPanel Spacing="6">
                  <TextBlock Text="Zeitraffer" FontWeight="SemiBold"/>
                  <TextBlock x:Name="TlInfo" Classes="note" Text="Solange Live verbunden ist, merkt sich Blockplan, wann welcher Block gesetzt wurde."/>
                  <Button x:Name="BtnTimelapse" Content="Zeitraffer ansehen" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="False"/>
                </StackPanel>
              </Border>
              <StackPanel x:Name="LivePlayers" Spacing="2"/>
            </StackPanel>
          </Border>

          <Border Classes="card" x:Name="ToolsCard">
            <StackPanel Spacing="8">
              <TextBlock Text="WERKZEUGE" Classes="h"/>
              <TextBlock Classes="note" Text="Messen: mit der rechten Maustaste im Plan ziehen."/>
              <ToggleButton x:Name="ToolArea" Content="Bauplan aus Bereich" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
              <ToggleButton x:Name="ToolPoint" Content="Punkt setzen" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
              <CheckBox x:Name="ShowPartsChk" Content="Baupläne im Plan zeigen" IsChecked="True"/>
              <TextBlock Text="Punkte" Classes="note" FontWeight="SemiBold"/>
              <StackPanel x:Name="PointsList" Spacing="2"/>
            </StackPanel>
          </Border>
          <Border Classes="card" x:Name="GuidesCard">
            <StackPanel Spacing="8">
              <TextBlock Text="HILFSLINIEN" Classes="h"/>
              <TextBlock Classes="note" Text="Für Plattformen, Mauerringe oder Buchten: Länge in Blöcken, beim Hineinzoomen als Blockraster."/>
              <WrapPanel>
                <Button x:Name="GAddEllipse" Content="+ Ellipse" Margin="0,0,6,6"/>
                <Button x:Name="GAddCircle" Content="+ Kreis" Margin="0,0,6,6"/>
                <Button x:Name="GAddRect" Content="+ Rechteck" Margin="0,0,6,6"/>
                <Button x:Name="GAddLine" Content="+ Linie" Margin="0,0,6,6"/>
              </WrapPanel>
              <TextBlock Classes="note" Text="Automatisch:" FontWeight="SemiBold"/>
              <WrapPanel>
                <Button x:Name="GAddOutline" Content="+ Umriss vom Bau" Margin="0,0,6,6" ToolTip.Tip="Zeichnet den Außenrand des Baus nach – in der Ebenen-Ansicht nur für die gezeigte Ebene"/>
                <Button x:Name="GAddGrid" Content="+ Raster" Margin="0,0,6,6" ToolTip.Tip="Gitterlinien in festem Abstand an Welt-Koordinaten (16 = Chunk-Grenzen)"/>
              </WrapPanel>
              <ToggleButton x:Name="GDrawLine" Content="✎ Linie mit der Maus ziehen" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Im Plan mit der linken Maustaste ziehen. Umschalt = nur gerade oder diagonal."/>
              <StackPanel x:Name="GuidesList" Spacing="8"/>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Text="PROJEKT" Classes="h"/>
              <TextBlock Text="Name" Classes="note"/>
              <TextBox x:Name="ProjName"/>
              <TextBlock x:Name="ProjSize" Classes="note"/>
              <TextBlock Text="Startecke im Spiel (Nordwest, unten)" Classes="note" Margin="0,6,0,0"/>
              <Grid ColumnDefinitions="*,6,*,6,*">
                <NumericUpDown Grid.Column="0" x:Name="OrX" FormatString="0" ShowButtonSpinner="False" PlaceholderText="X"/>
                <NumericUpDown Grid.Column="2" x:Name="OrY" FormatString="0" ShowButtonSpinner="False" PlaceholderText="Y"/>
                <NumericUpDown Grid.Column="4" x:Name="OrZ" FormatString="0" ShowButtonSpinner="False" PlaceholderText="Z"/>
              </Grid>
              <Border x:Name="SnowRow" IsVisible="False" Background="{DynamicResource SunkBrush}" CornerRadius="8" Padding="10,8" Margin="0,4,0,0">
                <StackPanel Spacing="6">
                  <TextBlock x:Name="SnowInfo" Classes="note"/>
                  <CheckBox x:Name="SnowBlocksChk" Content="auch Schneeblöcke"/>
                  <Button x:Name="BtnSnow" Content="Schnee entfernen" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                </StackPanel>
              </Border>
              <Button x:Name="BtnDelete" Content="Projekt löschen" Foreground="{DynamicResource DangerBrush}" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="6">
              <TextBlock Text="SPEICHER" Classes="h"/>
              <TextBlock x:Name="DbInfo" Classes="note"/>
              <Button x:Name="BtnCheckUpdate" Content="Nach Updates suchen" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,4,0,0"/>
              <TextBlock x:Name="UpdateNote" Classes="note" Text=""/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
